+package com.genymobile.scrcpy.video;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+public class SurfaceEncoderTest {
+
+    @Test
+    public void testConstrainSoftwareEncoderQuality() {
+        Assert.assertEquals(12_000_000, SurfaceEncoder.constrainBitRate(24_000_000, 12_000_000));
+        Assert.assertEquals(8_000_000, SurfaceEncoder.constrainBitRate(8_000_000, 12_000_000));
+        Assert.assertEquals(32_000_000, SurfaceEncoder.constrainBitRate(32_000_000, 0));
+        Assert.assertEquals(30, SurfaceEncoder.constrainFps(60, true));
+        Assert.assertEquals(30, SurfaceEncoder.constrainFps(30, true));
+        Assert.assertEquals(60, SurfaceEncoder.constrainFps(60, false));
+    }
+
+    @Test
+    public void testHardResetOnlyForSustainedStallOutsideCooldown() {
+        Assert.assertFalse(SurfaceEncoder.shouldHardReset(10_000, 9_000, 1_000, 0));
+        Assert.assertFalse(SurfaceEncoder.shouldHardReset(10_000, 0, 8_000, 0));
+        Assert.assertTrue(SurfaceEncoder.shouldHardReset(10_000, 1_000, 1_000, 0));
+        Assert.assertFalse(SurfaceEncoder.shouldHardReset(10_000, 1_000, 1_000, 5_000));
+        Assert.assertTrue(SurfaceEncoder.shouldHardReset(20_000, 1_000, 1_000, 5_000));
+    }
+}
